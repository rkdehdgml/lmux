{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "allow-app-state",
    "allow-shells-list",
    "allow-project-detect",
    "allow-project-add",
    "allow-project-remove",
    "allow-session-create",
    "allow-session-delete",
    "allow-session-start",
    "allow-session-attach",
    "allow-session-detach",
    "allow-session-ack",
    "allow-session-write",
    "allow-session-resize",
    "allow-session-kill",
    "allow-layout-set",
    "allow-layout-save",
    "allow-layout-delete",
    "allow-session-approve",
    "allow-account-list",
    "allow-get-changes",
    "allow-get-diff",
    "allow-svn-commit-cmd",
    "allow-svn-revert-cmd",
    "allow-svn-update-cmd",
    "allow-git-commit-cmd",
    "allow-git-worktree-list-cmd",
    "allow-git-worktree-add-cmd",
    "allow-git-worktree-remove-cmd",
    "notification:allow-notify",
    "allow-mobile-start",
    "allow-mobile-status",
    "allow-mobile-qr-info",
    "allow-mobile-approve-pairing",
    "allow-mobile-reject-pairing",
    "allow-mobile-revoke-device",
    "allow-mobile-set-permission",
    "allow-mobile-get-devices",
    "allow-mobile-access-log"
  ]
}
